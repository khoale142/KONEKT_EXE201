{
  "name": "dn26-cpl-react-011-backend",
  "private": true,
  "version": "1.0.0",
  "description": "Backend API server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "npx drizzle-kit generate",
    "db:migrate": "npx tsx src/db/migrate.ts",
    "db:seed": "npx tsx src/db/seed.ts",
    "db:studio": "npx drizzle-kit studio",
    "migrate:staff-profile": "npx ts-node scripts/migrate-staff-profile.ts",
    "migrate:username-format": "npx ts-node scripts/migrate-username-format.ts",
    "migrate:notifications-recipients": "npx ts-node scripts/migrate-notifications-recipients.ts",
    "check:schema": "npx ts-node scripts/check-users-schema.ts",
    "audit:canonical-memberships": "npx tsx src/scripts/audit_canonical_memberships.ts",
    "audit:workforce-memberships": "npx tsx src/scripts/audit_workforce_memberships.ts",
    "audit:legacy-runtime": "npx tsx src/scripts/audit_legacy_runtime.ts",
    "backfill:canonical-memberships": "npx tsx src/scripts/backfill_canonical_memberships.ts",
    "test:canonical-memberships": "npx tsx src/scripts/test_canonical_memberships.ts",
    "test:canonical-workspace-session": "npx tsx src/scripts/test_canonical_workspace_session.ts",
    "test:canonical-authorization": "npx tsx src/scripts/test_canonical_authorization.ts",
    "test:canonical-store-invite-onboarding": "npx tsx src/scripts/test_canonical_store_invite_onboarding.ts",
    "test:workforce-membership-identity": "npx tsx src/scripts/test_workforce_membership_identity.ts",
    "seed:chat-faq": "npx ts-node scripts/seed-chat-faq.ts",
    "check:chatbot": "npx ts-node scripts/check-chatbot-regression.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.1",
    "pg": "^8.19.0",
    "postgres": "^3.4.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.16.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.7.0"
  }
}
